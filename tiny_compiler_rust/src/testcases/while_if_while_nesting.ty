main
var a, b, c, d;
{
    let a <- call InputNum();
    let b <- 0;
    let c <- 1;
    let d <- 0;
    while a > 0 do
        if a < 10 then
            let b <- b + c;
            let c <- c + 1;
            while d < 3 do
                let b <- b + a;
                let d <- d + 1;
            od;
            let a <- a - 1;
        else
            let c <- c * 2;
            let d <- 0;
        fi;
        let a <- a - 1;
    od;
    call OutputNum(a);
    call OutputNum(b);
    call OutputNum(c);
    call OutputNum(d);
    call OutputNewLine();
}.