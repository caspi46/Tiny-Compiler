main
var x, y, z;
{
    let x <- 1;
    let y <- 2;
    let z <- 0;
    while x < 5 do
        if y > 1 then
            let x <- x + 1;
            let z <- z + 1;
        else
            let y <- y + 1;
        fi;
        let x <- x + 1;
    od;
    call OutputNum(x);
    call OutputNum(y);
    call OutputNum(z);
    
}.